"use client";

import { useEffect, useState } from "react";
import { supabase } from "@/lib/supabaseClient";

type Job = {
  id: number;
  title: string;
  description: string;
  status: string;
  created_at: string;
};

export default function ProJobsPage() {
  const [jobs, setJobs] = useState<Job[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    fetchJobs();
  }, []);

  async function fetchJobs() {
    const { data, error } = await supabase
      .from("jobs")
      .select("*")
      .order("created_at", { ascending: false });

    if (!error && data) {
      setJobs(data);
    }
    setLoading(false);
  }

  async function claimJob(jobId: number) {
    const { error } = await supabase.rpc("claim_job", {
      p_job_id: jobId,
    });

    if (error) {
      alert(error.message);
    } else {
      alert("Job claimed!");
      fetchJobs();
    }
  }

  return (
    <div style={styles.page}>
      <h1 style={styles.title}>Available Jobs</h1>

      {loading && <p style={styles.text}>Loading jobs...</p>}

      {!loading && jobs.length === 0 && (
        <p style={styles.text}>No jobs available.</p>
      )}

      {jobs.map((job) => (
        <div key={job.id} style={styles.card}>
          <div style={styles.cardHeader}>
            <h2 style={styles.jobTitle}>{job.title}</h2>
            <span
              style={{
                ...styles.status,
                backgroundColor:
                  job.status === "open"
                    ? "#16a34a"
                    : job.status === "negotiating"
                    ? "#facc15"
                    : "#6b7280",
              }}
            >
              {job.status.toUpperCase()}
            </span>
          </div>

          <p style={styles.description}>{job.description}</p>

          <button
            style={styles.button}
            disabled={job.status !== "open"}
            onClick={() => claimJob(job.id)}
          >
            Claim Job
          </button>
        </div>
      ))}
    </div>
  );
}

const styles: { [key: string]: React.CSSProperties } = {
  page: {
    minHeight: "100vh",
    backgroundColor: "#0f172a",
    padding: "40px",
    color: "#e5e7eb",
  },
  title: {
    fontSize: "28px",
    fontWeight: "bold",
    marginBottom: "30px",
    color: "#22c55e",
  },
  text: {
    color: "#9ca3af",
  },
  card: {
    backgroundColor: "#020617",
    border: "1px solid #1f2933",
    borderRadius: "12px",
    padding: "20px",
    marginBottom: "20px",
    boxShadow: "0 10px 30px rgba(0,0,0,0.4)",
  },
  cardHeader: {
    display: "flex",
    justifyContent: "space-between",
    alignItems: "center",
    marginBottom: "10px",
  },
  jobTitle: {
    fontSize: "20px",
    fontWeight: "600",
    color: "#e5e7eb",
  },
  status: {
    padding: "6px 12px",
    borderRadius: "999px",
    fontSize: "12px",
    fontWeight: "bold",
    color: "#020617",
  },
  description: {
    color: "#9ca3af",
    marginBottom: "15px",
  },
  button: {
    backgroundColor: "#22c55e",
    color: "#020617",
    border: "none",
    borderRadius: "8px",
    padding: "10px 16px",
    fontWeight: "bold",
    cursor: "pointer",
  },
};
